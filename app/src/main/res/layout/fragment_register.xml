                    android:fontFamily="@font/poppins"
                    android:hint="@string/enter_address"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine"
                    android:maxLines="5"
                    android:minHeight="55dp"
                    android:padding="15dp"
                    android:textSize="@dimen/sixteen_sp"
